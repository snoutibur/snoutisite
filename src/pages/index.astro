---
import BaseLayout from "../layouts/BaseLayout.astro"
import "@styles/pages/index.scss"
import "@styles/components/cards.scss";
import { Image } from "astro:assets";
import { Masonry } from 'astro-masonry';
---

<BaseLayout>
    <Fragment slot="head">
        <title>snoutibur home</title>
    </Fragment>

    <section id="title">
        <Image
                id="hero"
                src={import('../assets/img/landing.webp')}
                alt="Landing hero image"
                sizes="(max-width: 2048px) 100vw, 300px"
                quality={80}
                format="webp"
        />

        <div id="title-content">
            <div>
                <h1>snoutibur</h1>
                <ul>
                    <li>Artist</li>
                    <li>Musician</li>
                    <li>Programmer</li>
                </ul>
            </div>

            <hr>

            <div>
                <h2>Haii!</h2>
                <p>
                    I'm a university student pursuing a Bachelor of Science in Computer Science.
                    <br>Outside of CS, I write & produce music, make digital art, and 3D model.
                </p>
            </div>

            <article id="socials">
                <ul class="socials-list">
                    <li>
                        <a href="https://github.com/snoutibur" target="_blank">
                            <img src="/socials/GitHub.svg" alt="GitHub" class="socials">
                        </a>
                    </li>

                    <li>
                        <a href="https://codeberg.org/snoutibur" target="_blank">
                            <img src="/socials/codeberg-logo_icon_white.svg" alt="Codeberg" class="socials" loading="lazy">
                        </a>
                    </li>

                    <li>
                        <a href="https://www.discord.com/users/490265170277662720" target="_blank">
                            <img src="/socials/Discord.svg" alt="Discord" class="socials">
                        </a>
                    </li>

                    <li>
                        <a href="https://www.youtube.com/@snoutibur" target="_blank"><img src="/socials/YouTube.svg" alt="YouTube" class="socials"></a>
                    </li>
                </ul>
            </article>
        </div>
    </section>

    <main>
        <section id="featured">
            <h1>Featured</h1>
        </section>

        <section id="content-categories">
            <Masonry
                    breakpointCols={{
                        default: 4,
                        1200: 2,
                        621: 1,
                    }}
            >
                <a href="/cs">
                    <article class="split-card-h">
                        <h1>CS & Programming</h1>
                        <p>
                            Larger programming projects that made the cut to be featured
                        </p>
                    </article>
                </a>

                <a href="/discography/landing">
                    <article class="split-card-h">
                        <h1>Music</h1>
                        <p>
                            Music I've written, produced and released.<br>
                            I primarily produce a fusion of electronic and orchestral.
                        </p>
                    </article>
                </a>

                <a href="/artworks/landing">
                    <article class="split-card-h">
                        <Image
                                src={import('../assets/img/ArtThumbnail.png')}
                                alt="final sketch overlay"
                                sizes="(max-width: 2048px) 100vw, 300px"
                                quality={80}
                                format="webp"`
                        />
                        <h1>Artworks</h1>
                        <p>
                            Visual artworks (Digital art & 3D art bunched together)
                        </p>
                    </article>
                </a>

                <a href="/misc/landing">
                    <article class="split-card-h">
                        <h1>Misc Stuff</h1>
                        <p>
                            One off items that don't fit in other categories
                        </p>
                    </article>
                </a>
            </Masonry>
        </section>
    </main>
</BaseLayout>