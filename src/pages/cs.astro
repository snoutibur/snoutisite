---
import BaseLayout from "../layouts/BaseLayout.astro";
import "@styles/components/cards.scss";

import {Image} from "astro:assets";
import {Masonry} from "astro-masonry";
---

<BaseLayout>
    <Fragment slot="head">
        <title>CS & Programming</title>
    </Fragment>

    <header>
        <h1>Computer Science</h1>
    </header>

    <main>
        <div class="readable-width">
            <section id="projects">
                <h1>Projects</h1>
                <p>Major programming projects. Clicking on the card will direct offsite to the project's home (its source repo or showcase website).</p>
                <Masonry>
                    <a href="https://midingo.snoutibur.com/" target="_blank">
                        <article class="split-card-h">
                            <h1>Midingo</h1>
                            <p>
                                A piano trainer designed like a rhythm game featuring real time scoring. Supports MIDI files as charts and MIDI controllers for inputs.
                            </p>
                            <ul>
                                <li>Game built using Godot, C#, DryWetMIDI, and SQLite</li>
                                <li>Website built using Astro + Sass</li>
                                <li>Devlog built using Astro collections</li>
                                <li>Documentation site built using Starlight</li>
                            </ul>
                            <small>2025</small>
                        </article>
                    </a>

                    <a href="https://github.com/snoutibur/snoutisite" target="_blank">
                        <article class="split-card-h">
                            <h1>Personal (General) Portfolio</h1>
                            <p>
                                The website you're looking at right now!<br>
                                A showcase of my various creative & technical projects built using Astro and SCSS + CSS.
                            </p>
                            <small>2025</small>
                        </article>
                    </a>
                </Masonry>
            </section>

            <hr>

            <h1>Profiles</h1>
            <p>These are my personal git forge profiles. Some projects of mine are under their own organization.</p>
            <Masonry
                    breakpointCols={{
                        default: 6,
                        1200: 4,
                        621: 1,
                    }}
            >
                <a href="https://github.com/snoutibur" target="_blank">
                    <article class="split-card-h-small">
                        <img src="https://avatars.githubusercontent.com/u/157987813" alt="Main profile">
                        <h1>snoutibur (GitHub)</h1>
                        <p>
                            Main GitHub account.
                        </p>
                    </article>
                </a>

                <a href="https://codeberg.org/snoutibur" target="_blank">
                    <article class="split-card-h-small">
                        <img src="https://avatars.githubusercontent.com/u/157987813" alt="Main profile">
                        <h1>snoutibur (Codeberg)</h1>
                        <p>
                            Main Codeberg account.
                        </p>
                    </article>
                </a>

                <a href="https://github.com/snoutiscratch" target="_blank">
                    <article class="split-card-h-small">
                        <img src="https://avatars.githubusercontent.com/u/215105552?s=800" alt="Dog otter profile">
                        <h1>snoutiscratch</h1>
                        <p>
                            Project scrapbook & GitHub garden.<br>
                            These projects are most likely abandoned after completion or interest is lost.
                        </p>
                    </article>
                </a>

                <a href="https://github.com/snoutibur-academic" target="_blank">
                    <article class="split-card-h-small">
                        <img src="https://avatars.githubusercontent.com/u/215185128?s=800" alt="CS is BS Profile">
                        <h1>schoolzstuffs</h1>
                        <p>
                            Coursework; for school and academia.<br>
                            Most code here is private as it's against policy for some classes to publish coursework
                            publicly.
                        </p>
                    </article>
                </a>
            </Masonry>
        </div>
    </main>
</BaseLayout>