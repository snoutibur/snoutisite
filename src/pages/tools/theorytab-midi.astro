---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "@styles/pages/tools/theorytab-midi.scss";
---

<BaseLayout>
    <Fragment slot="head">
        <title>Theorytab to MIDI</title>
    </Fragment>

    <header>
        <h1>TheoryTab to MIDI</h1>
    </header>

    <main>
        <section class="readable-width">
            <textarea
                    id="theorytab-input"
                    placeholder="Paste the contents of a TheoryTab here!"
                    rows="24"
            ></textarea>

            <button id="convert-button" type="button">
                Convert to MIDI
            </button>

            <h2>Usage</h2>
            <p>
                A simple utility to convert <a href="https://www.hooktheory.com/theorytab" target="_blank">HookTheory's
                TheoryTabs</a> to MIDI files. <br>
                On any TheoryTab, there will be a copy button. Copy either the melody, chords, or all, and paste it in
                the textbox above. Hit convert and a MIDI file will be automatically downloaded.
            </p>

            <h2>Known Limitations</h2>
            <p>The converter currently has the following features missing & unplanned</p>
            <ul>
                <li>Only support Major and Minor scales</li>
                <li>Only 4/4 time supported at this moment</li>
            </ul>
        </section>
    </main>
</BaseLayout>

<script>
    import {convertTheoryTab} from
            "@scripts/tools/theorytab-midi/converter";

    import {generateMidi} from
            "@scripts/tools/theorytab-midi/midi";

    const input = document.querySelector<HTMLTextAreaElement>(
        "#theorytab-input"
    );

    const button = document.querySelector<HTMLButtonElement>(
        "#convert-button"
    );

    button?.addEventListener("click", () => {
        if (!input) return;

        try {
            const notes = convertTheoryTab(input.value);
            const midiBytes = generateMidi(notes);
            const blob = new Blob(
                [new Uint8Array(midiBytes)],
                {type: "audio/midi"}
            );

            const url = URL.createObjectURL(blob);

            const anchor = document.createElement("a");
            anchor.href = url;
            anchor.download = "theorytab.mid";
            anchor.click();

            setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (error) {
            console.error("MIDI conversion failed:", error);
        }
    });
</script>