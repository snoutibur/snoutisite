---
import "../styles/components/footer.scss";
import "../styles/components/utilities.css";
---

<footer>
    <div id="footer-basics">
        <img src="/favicon.png" alt="wink pixel logo" loading="lazy">

        <div>
            <h1>snoutibur</h1>

            <article id="socials">
                <ul class="socials-list">
                    <li>
                        <a href="https://github.com/snoutibur" target="_blank">
                            <img src="/socials/GitHub.svg" alt="GitHub" class="socials" loading="lazy">
                        </a>
                    </li>

                    <li>
                        <a href="https://codeberg.org/snoutibur" target="_blank">
                            <img src="/socials/codeberg-logo_icon_white.svg" alt="Codeberg" class="socials" loading="lazy">
                        </a>
                    </li>

                    <li>
                        <a href="https://www.discord.com/users/490265170277662720" target="_blank">
                            <img src="/socials/Discord.svg" alt="Discord" class="socials" loading="lazy">
                        </a>
                    </li>

                    <li>
                        <a href="https://www.youtube.com/@snoutibur" target="_blank">
                            <img src="/socials/YouTube.svg" alt="YouTube" class="socials" loading="lazy">
                        </a>
                    </li>
                </ul>
            </article>
        </div>
    </div>

    <div id="footer-links">
        <h2>Narcissism</h2>
        <ul>
            <li><a href="/narcissism/gear">Gearhead corner</a></li>
        </ul>
    </div>

    <div>
        <p>
            This website is open source! Find it at <a href="https://www.github.com/snoutibur/snoutisite" target="_blank">GitHub/snoutibur/snoutisite</a>
        </p>
        <p>
            Made using <a href="https://astro.build/" target="_blank">Astro</a>.
        </p>
        <small>© 2026 snoutibur | updated 2026.Aug.21</small>
    </div>
</footer>